<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.ProfileController"
      spacing="0" prefHeight="700.0" prefWidth="1000.0">

    <!-- 顶部栏 -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" visible="false" managed="false"
                style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        <Label fx:id="titleLabel" text="学生管理系统"
               style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="profileButton" text="个人中心"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER">
            <VBox alignment="TOP_CENTER" spacing="15" style="-fx-padding: 30;"
                  maxWidth="500">

                <!-- 头像区域 -->
                <VBox alignment="CENTER" spacing="10">
                    <Label fx:id="avatarIcon" text="?"
                           style="-fx-font-size: 48; -fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 80; -fx-min-height: 80; -fx-alignment: center;"/>
                    <Label fx:id="nameLabel" text="" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                    <Label fx:id="roleLabel" text="" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>
                </VBox>

                <!-- 基本信息 -->
                <TitledPane text="基本信息" expanded="true" maxWidth="500"
                            style="-fx-font-size: 14;">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <HBox spacing="10"><Label text="姓名：" style="-fx-min-width: 80;"/><Label fx:id="infoNameLabel" text=""/></HBox>
                        <HBox spacing="10"><Label text="工号/学号：" style="-fx-min-width: 80;"/><Label fx:id="schIdLabel" text=""/></HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="手机号：" style="-fx-min-width: 80;"/>
                            <Label fx:id="phoneLabel" text=""/>
                            <TextField fx:id="phoneEditField" promptText="新手机号" visible="false" managed="false"
                                       style="-fx-pref-width: 150;"/>
                            <Button fx:id="editPhoneBtn" text="修改"
                                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 12;"/>
                        </HBox>
                        <HBox spacing="10"><Label text="身份：" style="-fx-min-width: 80;"/><Label fx:id="infoRoleLabel" text=""/></HBox>
                    </VBox>
                </TitledPane>

                <!-- 修改密码 -->
                <TitledPane text="修改密码" expanded="false" maxWidth="500"
                            style="-fx-font-size: 14;">
                    <VBox spacing="10" style="-fx-padding: 15;">
                        <PasswordField fx:id="oldPasswordField" promptText="旧密码"/>
                        <PasswordField fx:id="newPasswordField" promptText="新密码"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="确认新密码"/>
                        <Button fx:id="changePasswordBtn" text="确认修改"
                                style="-fx-background-color: #3498db; -fx-text-fill: white;"
                                maxWidth="200"/>
                    </VBox>
                </TitledPane>

                <!-- 退出登录 -->
                <Button fx:id="logoutBtn" text="退出登录"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14; -fx-pref-height: 40;"
                        maxWidth="400"/>
            </VBox>
        </HBox>
    </ScrollPane>
</VBox>
