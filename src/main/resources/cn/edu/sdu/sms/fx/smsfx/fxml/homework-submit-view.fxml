<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.HomeworkSubmitController"
      spacing="0" prefHeight="700.0" prefWidth="1000.0">

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" visible="false" managed="false" 
                style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        <Label fx:id="titleLabel" text="学生管理系统"
               style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="profileButton" text="个人中心"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="15" style="-fx-padding: 30;">

            <Label fx:id="hwTitleLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
                <HBox spacing="10"><Label text="所属课程：" style="-fx-min-width: 80; -fx-font-weight: bold;"/><Label fx:id="courseLabel"/></HBox>
                <HBox spacing="10"><Label text="任课教师：" style="-fx-min-width: 80; -fx-font-weight: bold;"/><Label fx:id="teacherLabel"/></HBox>
                <HBox spacing="10"><Label text="截止时间：" style="-fx-min-width: 80; -fx-font-weight: bold;"/><Label fx:id="deadlineLabel"/></HBox>
                <HBox spacing="10"><Label text="提交状态：" style="-fx-min-width: 80; -fx-font-weight: bold;"/><Label fx:id="statusLabel"/></HBox>
            </VBox>

            <!-- 作业内容/题目要求 -->
            <VBox spacing="5" style="-fx-background-color: #eaf2f8; -fx-background-radius: 5; -fx-padding: 12;">
                <Label text="📋 作业要求：" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2c3e50;"/>
                <TextArea fx:id="homeworkContentArea" editable="false" prefRowCount="5" wrapText="true"
                          style="-fx-background-color: white; -fx-control-inner-background: white;"/>
            </VBox>

            <!-- 教师作业附件 -->
            <VBox fx:id="homeworkAttachmentBox" spacing="5" visible="false" managed="false"
                  style="-fx-background-color: #eaf2f8; -fx-background-radius: 5; -fx-padding: 12;">
                <Label text="📎 作业附件：" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2c3e50;"/>
            </VBox>

            <!-- 已提交内容展示区（含批改结果 + AI建议） -->
            <VBox fx:id="previousSubmissionBox" spacing="8" visible="false" managed="false"
                  style="-fx-background-color: #f8f9fa; -fx-background-radius: 5; -fx-padding: 12;">
                <Label text="我的提交内容：" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <TextArea fx:id="previousContentArea" editable="false" prefRowCount="6" wrapText="true"/>
                <Label fx:id="submitTimeLabel" text="" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;"/>

                <!-- 已提交附件 -->
                <VBox fx:id="submittedAttachmentBox" spacing="5" visible="false" managed="false"/>

                <!-- 批改结果区（仅已批改时显示） -->
                <Separator visible="false" managed="false" fx:id="gradeSeparator"/>
                <VBox fx:id="gradeBox" spacing="5" visible="false" managed="false">
                    <Label text="批改结果" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #27ae60;"/>
                    <HBox spacing="20">
                        <Label fx:id="scoreLabel" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </HBox>
                    <Label text="教师评语：" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <Label fx:id="commentLabel" wrapText="true"
                           style="-fx-text-fill: #555; -fx-background-color: #fff; -fx-background-radius: 3; -fx-padding: 8;"/>

                    <!-- AI 学习建议 -->
                    <Separator/>
                    <Button fx:id="aiSuggestionBtn" text="AI 学习建议"
                            style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-size: 13;"/>
                    <VBox fx:id="aiSuggestionBox" spacing="5" visible="false" managed="false"
                          style="-fx-background-color: #f4ecf7; -fx-background-radius: 5; -fx-padding: 10;">
                        <Label text="AI 学习改进建议：" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #6c3483;"/>
                        <Label fx:id="aiSuggestionLabel" wrapText="true"
                               style="-fx-text-fill: #555; -fx-font-size: 13;"/>
                    </VBox>
                </VBox>
            </VBox>

            <Label fx:id="deadlinePassedLabel" text="已超过提交截止时间，无法提交"
                   style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 14;"
                   visible="false" managed="false"/>

            <VBox fx:id="submitArea" spacing="10" visible="false" managed="false">
                <Label text="提交作业内容：" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="contentArea" promptText="请输入作业内容" prefRowCount="10" wrapText="true"/>

                <!-- 附件上传区 -->
                <VBox spacing="5">
                    <Label text="📎 附件（可选）：" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                    <HBox spacing="10">
                        <Button fx:id="selectFileBtn" text="选择文件"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 12;"/>
                    </HBox>
                    <VBox fx:id="pendingAttachmentBox" spacing="3"/>
                </VBox>

                <Button fx:id="submitBtn" text="提交作业"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14;"/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
