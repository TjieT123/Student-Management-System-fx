<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.CourseMaterialsController">
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        <Label fx:id="titleLabel" text="课程资料管理" style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="profileButton" text="个人中心" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="12" style="-fx-padding: 20;">
            <Label fx:id="hintLabel" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="选择课程:"/>
                <ComboBox fx:id="courseCombo" prefWidth="250" promptText="请选择课程"/>
                <Button fx:id="uploadBtn" text="📎 上传资料" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            </HBox>
            <Label text="课程资料列表:" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
            <VBox fx:id="materialsBox" spacing="8"/>
        </VBox>
    </ScrollPane>
</VBox>
