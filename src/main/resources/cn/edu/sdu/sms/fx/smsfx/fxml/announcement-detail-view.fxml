<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.AnnouncementDetailController"
      spacing="0" prefHeight="700.0" prefWidth="1000.0">

    <!-- 顶部栏 -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" visible="false" managed="false"
                style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        <Label fx:id="titleLabel" text="学生管理系统"
               style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="profileButton" text="个人中心"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="15" style="-fx-padding: 30;">

            <Label fx:id="announcementTitleLabel"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                   wrapText="true"/>

            <HBox spacing="20">
                <Label fx:id="publisherLabel" style="-fx-font-size: 13; -fx-text-fill: #7f8c8d;"/>
                <Label fx:id="timeLabel" style="-fx-font-size: 13; -fx-text-fill: #95a5a6;"/>
            </HBox>

            <Separator/>

            <Label fx:id="contentLabel" text="" wrapText="true"
                   style="-fx-font-size: 15; -fx-text-fill: #333; -fx-line-spacing: 5;"/>
        </VBox>
    </ScrollPane>
</VBox>
