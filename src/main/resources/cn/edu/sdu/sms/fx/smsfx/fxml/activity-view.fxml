<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.ActivityController">
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" style="-fx-background-color: transparent; -fx-text-fill: white;"/><Label fx:id="titleLabel" text="日常活动" style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/><Button fx:id="profileButton" text="个人中心" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="10" style="-fx-padding: 20;">
            <TextField fx:id="searchField" promptText="搜索活动标题或地点..." style="-fx-pref-width: 400;"/>
            <VBox fx:id="activityContainer" spacing="8"/>
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="prevPageBtn" text="上一页"/><Label fx:id="pageLabel" text="第 1/1 页"/><Button fx:id="nextPageBtn" text="下一页"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
