<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.AdminHomeController"
      spacing="0" prefHeight="700.0" prefWidth="1000.0">

    <!-- 顶部栏 -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" visible="false" managed="false"
                style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        <Label fx:id="titleLabel" text="学生管理系统"
               style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="profileButton" text="个人中心"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>

    <BorderPane VBox.vgrow="ALWAYS">
        <!-- 左侧导航栏 -->
        <left>
            <VBox fx:id="sidebar" prefWidth="200"
                  style="-fx-background-color: #34495e; -fx-padding: 10 0;">
                <Label text="管理菜单"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 10;"/>
                <Separator style="-fx-background-color: #2c3e50;"/>

                <Button fx:id="homeBtn" text="🏠 首页" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #f39c12; -fx-alignment: CENTER-LEFT; -fx-font-size: 14; -fx-padding: 10 20;"/>
                <Separator style="-fx-background-color: #2c3e50;"/>
            </VBox>
        </left>

        <!-- 右侧内容区 -->
        <center>
            <VBox>
                <Label fx:id="sectionTitle" text="欢迎使用管理后台"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 20;"/>
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                    <Label text="请从左侧菜单选择管理功能"
                           style="-fx-font-size: 16; -fx-text-fill: #95a5a6; -fx-padding: 50;"/>
                </StackPane>
            </VBox>
        </center>
    </BorderPane>
</VBox>
