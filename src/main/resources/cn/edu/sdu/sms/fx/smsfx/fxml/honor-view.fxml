<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.HonorViewController">
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" style="-fx-background-color: transparent; -fx-text-fill: white;"/><Label fx:id="titleLabel" text="荣誉管理" style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/><Button fx:id="profileButton" text="个人中心" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"><VBox fx:id="contentBox" spacing="10" style="-fx-padding: 20;"/></ScrollPane>
</VBox>
