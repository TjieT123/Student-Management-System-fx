<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.CourseSelectionDetailController"
      spacing="0" prefHeight="700.0" prefWidth="1000.0">

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" visible="false" managed="false"
                style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        <Label fx:id="titleLabel" text="学生管理系统"
               style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="profileButton" text="个人中心"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="15" style="-fx-padding: 20;">

            <Label fx:id="courseNameLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
                <HBox spacing="10"><Label text="任课教师：" style="-fx-min-width: 80; -fx-font-weight: bold;"/><Label fx:id="teacherLabel"/></HBox>
                <HBox spacing="10"><Label text="授课地点：" style="-fx-min-width: 80; -fx-font-weight: bold;"/><Label fx:id="addressLabel"/></HBox>
                <VBox spacing="5"><Label text="课程简介：" style="-fx-font-weight: bold;"/><Label fx:id="detailLabel" wrapText="true" style="-fx-text-fill: #555;"/></VBox>
            </VBox>

            <Button fx:id="enrollBtn" text="选课"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14;"
                    visible="false" managed="false"/>

            <Label fx:id="enrolledLabel" text="✓ 已选课"
                   style="-fx-font-size: 16; -fx-text-fill: #27ae60; -fx-font-weight: bold;"
                   visible="false" managed="false"/>

            <Button fx:id="goToCourseBtn" text="前往课程详情"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14;"
                    visible="false" managed="false"/>
        </VBox>
    </ScrollPane>
</VBox>
