<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.edu.sdu.sms.fx.smsfx.controller.HomeworkGradingController"
      spacing="0" prefHeight="700.0" prefWidth="1000.0">

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #2c3e50; -fx-padding: 10;" prefHeight="50">
        <Button fx:id="backButton" text="← 返回" visible="false" managed="false"
                style="-fx-background-color: transparent; -fx-text-fill: white;"/>
        <Label fx:id="titleLabel" text="学生管理系统"
               style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="profileButton" text="个人中心"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="15" style="-fx-padding: 30;">

            <Label text="学生信息" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <HBox spacing="10"><Label text="学生姓名：" style="-fx-min-width: 80;"/><Label fx:id="studentNameLabel"/></HBox>
            <HBox spacing="10"><Label text="任课教师：" style="-fx-min-width: 80;"/><Label fx:id="teacherNameLabel"/></HBox>
            <HBox spacing="10"><Label text="提交时间：" style="-fx-min-width: 80;"/><Label fx:id="submitTimeLabel"/></HBox>
            <HBox spacing="10"><Label text="状态：" style="-fx-min-width: 80;"/><Label fx:id="statusLabel"/></HBox>

            <Label text="作业内容：" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <TextArea fx:id="contentDisplay" editable="false" prefRowCount="12" wrapText="true"/>

            <Label text="批改" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <HBox spacing="10"><Label text="分数："/><TextField fx:id="scoreField" prefWidth="80" promptText="0-100"/></HBox>
            <Label text="评语："/>
            <TextArea fx:id="commentArea" promptText="请输入评语" prefRowCount="4" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="aiGradeBtn" text="AI判卷"
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-size: 14;"/>
                <Button fx:id="submitGradeBtn" text="提交批改"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14;"/>
                <Label fx:id="aiStatusLabel" text="" visible="false" managed="false"
                       style="-fx-text-fill: #8e44ad; -fx-font-size: 13;"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
